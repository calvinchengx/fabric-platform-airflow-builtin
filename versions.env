# The pinned stack. Never `latest` -- a green run must say WHICH images it
# verified, or it says only that something, somewhere, worked.
#
# THE AIRFLOW VERSION IS NOT PINNED HERE, deliberately. It is the emulator's:
# `fabric-emulator` ships the sidecar because the Airflow runtime is part of
# what an `ApacheAirflowJob` IS, the same way Sail is part of what a Fabric
# Spark pool is. Microsoft supports exactly Airflow 2.10.5 on Python 3.12 and a
# user cannot choose otherwise, so a platform pinning its own would be
# inventing a choice Fabric does not offer.
FABRIC_EMULATOR_VERSION=0.34.0
FABRIC_EMULATOR_DIGEST=sha256:7383cd5fe9c597a98eac84284e6e644261a9622f5fe5fd3a90be31edf20c7908
ENTRA_EMULATOR_VERSION=0.9.0
ENTRA_EMULATOR_DIGEST=sha256:19418a503b6459d1f9db4e0d7657f78bf01655269ce7abef968fd5d1eb80da86

# Fabric's built-in Airflow runtime. NOT this platform's choice: Microsoft
# supports exactly 2.10.5 on Python 3.12 for Apache Airflow jobs, and a user
# cannot select another. Its supporting services are Celery's, which Fabric
# also does not let a user opt out of.
AIRFLOW_VERSION=2.10.5-python3.12
POSTGRES_VERSION=16.4
POSTGRES_DIGEST=sha256:e62fbf9d3e2b49816a32c400ed2dba83e3b361e6833e624024309c35d334b412
REDIS_VERSION=7.4-alpine
REDIS_DIGEST=sha256:ff02b58f971e7d7d156a1267e283fcbbeee91773b6aa36c49dac28ecfe28eadf

# The Spark engine behind Fabric's Livy surface, pinned by digest as well as
# tag: a tag can be moved, a digest is the image that was verified.
# SAIL_ENGINE and SPARK_CLIENT are tagged for the DEPENDENCY they carry --
# pysail and pyspark-client -- because that is what a consumer pins them for.
# The tag therefore says nothing about the first-party launcher and agent code,
# which moves independently and is republished under the SAME tag. Three fields,
# three jobs: _VERSION is the tag (what Sail you get), _DIGEST is the identity
# (which build exactly), _RELEASE is the fabric-emulator release that packaged
# it, read from the image's own org.opencontainers.image.version label.
#
# _RELEASE is DERIVED, never typed: CI re-reads the label from the pinned digest
# and fails if it disagrees. It exists because the drift that went unnoticed was
# first-party code moving under an unchanged tag -- invisible unless you diff
# digests by eye, and obvious the moment a release number sits beside a
# sibling's.
SAIL_ENGINE_VERSION=0.7.0
SAIL_ENGINE_DIGEST=sha256:f2bc4a48b51e40ec32d82964397887554d11b44dab1ff624eff581872083b693
SAIL_ENGINE_RELEASE=0.34.0
SPARK_CLIENT_VERSION=4.2.0
SPARK_CLIENT_DIGEST=sha256:7afe03dcbbf959f0b8dea0685a2435145857beddafa6feeda4c7c9f331ca49c7
SPARK_CLIENT_RELEASE=0.34.0

# The T-SQL engine behind the Warehouse's TDS surface. Microsoft's own image.
MSSQL_VERSION=2022-latest
MSSQL_DIGEST=sha256:ba4c8329f48fb8f02e1416be6a930ebfd71268caee78aa985f3af4315e457c89
PYTHON_VERSION=3.12

# NO MOKAPI, REDPANDA OR DEBEZIUM PIN HERE, deliberately. Those images are what
# the VENDORS are, and `contoso-sources/versions.env` pins them -- this platform
# reads them from there when it generates the vendor stack. A copy here would be
# a second place for the same fact, and a platform pinning a vendor's simulator
# is a platform deciding what the vendor is.
#
# POSTGRES_VERSION stays because this platform runs its OWN postgres for
# Airflow's metadata database, which is unrelated to the ERP vendor's. Two
# postgres pins that happen to match today are still two different decisions.
# PYTHON_VERSION stays because it is the interpreter this platform runs a
# vendor's seed script with -- mechanism, not content.
